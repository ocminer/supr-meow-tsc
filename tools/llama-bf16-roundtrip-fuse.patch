+// MEOW: fused f32 -> bf16 -> f32 round trip (ggml_cast(ggml_cast(x, BF16), F32)).
+// Same conversions as the two cpy_scalar_contiguous kernels it replaces, so the
+// result is bit-identical; one launch and 8 instead of 12 bytes of traffic/element.
+static __global__ void meow_bf16_roundtrip_f32x4(const float4 * __restrict__ x, float4 * __restrict__ dst, const int64_t n4) {
+    for (int64_t i = (int64_t)blockDim.x*blockIdx.x + threadIdx.x; i < n4; i += (int64_t)blockDim.x*gridDim.x) {
+        float4 v = x[i];
+        v.x = ggml_cuda_cast<float>(ggml_cuda_cast<nv_bfloat16>(v.x));
+        v.y = ggml_cuda_cast<float>(ggml_cuda_cast<nv_bfloat16>(v.y));
+        v.z = ggml_cuda_cast<float>(ggml_cuda_cast<nv_bfloat16>(v.z));
+        v.w = ggml_cuda_cast<float>(ggml_cuda_cast<nv_bfloat16>(v.w));
+        dst[i] = v;
+    }
+}
+
+static __global__ void meow_bf16_roundtrip_f32(const float * __restrict__ x, float * __restrict__ dst, const int64_t ne) {
+    for (int64_t i = (int64_t)blockDim.x*blockIdx.x + threadIdx.x; i < ne; i += (int64_t)blockDim.x*gridDim.x) {
+        dst[i] = ggml_cuda_cast<float>(ggml_cuda_cast<nv_bfloat16>(x[i]));
+    }
+}
+
+void ggml_cuda_bf16_roundtrip(ggml_backend_cuda_context & ctx, const ggml_tensor * src, ggml_tensor * dst) {
+    GGML_ASSERT(src->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(dst) && ggml_nelements(src) == ggml_nelements(dst));
+    const int64_t ne = ggml_nelements(src);
+    if (ne == 0) {
+        return;
+    }
+    cudaStream_t stream = ctx.stream();
+    const int block = 256;
+    const int max_blocks = 65535;
+    if (ne % 4 == 0 && (uintptr_t) src->data % 16 == 0 && (uintptr_t) dst->data % 16 == 0) {
+        const int64_t n4 = ne / 4;
+        const int blocks = (int) std::min<int64_t>((n4 + block - 1) / block, max_blocks);
+        meow_bf16_roundtrip_f32x4<<<blocks, block, 0, stream>>>((const float4 *) src->data, (float4 *) dst->data, n4);
+    } else {
+        const int blocks = (int) std::min<int64_t>((ne + block - 1) / block, max_blocks);
+        meow_bf16_roundtrip_f32<<<blocks, block, 0, stream>>>((const float *) src->data, (float *) dst->data, ne);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
