+// MEOW: ggml_cast(ggml_cast(x, BF16), F32) as emitted by meow_bf16_graph().
+// ggml_cast sets src[1] to the node itself, so the inner BF16 node's use count is
+// 2 (self + the outer cast); require exactly that, so nothing else reads the BF16.
+static bool meow_bf16_roundtrip_fusable(const struct ggml_cgraph * cgraph, int i) {
+    static const bool enabled = [] { const char * e = getenv("MEOW_BF16_FUSE"); return !(e && e[0] == '0'); }();
+    if (!enabled || i + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * a = cgraph->nodes[i];
+    const ggml_tensor * b = cgraph->nodes[i + 1];
+    if (a->op != GGML_OP_CPY || b->op != GGML_OP_CPY || a->src[1] != a || b->src[1] != b || b->src[0] != a) {
+        return false;
+    }
+    if (a->src[0] == nullptr || a->src[0]->type != GGML_TYPE_F32 || a->type != GGML_TYPE_BF16 || b->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if ((b->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (a->flags & GGML_TENSOR_FLAG_OUTPUT) || a->view_src) {
+        return false;
+    }
+    if (ggml_node_get_use_count(cgraph, i) != 2) {
+        return false;
+    }
+    if (!ggml_is_contiguous(a->src[0]) || !ggml_is_contiguous(b) || ggml_nelements(a->src[0]) != ggml_nelements(b)) {
+        return false;
+    }
+    // The allocator may hand the freed input buffer to the outer cast. Identical
+    // pointers are safe for an elementwise kernel; a partial overlap is not.
+    const char * x0 = (const char *) a->src[0]->data; const char * x1 = x0 + ggml_nbytes(a->src[0]);
+    const char * d0 = (const char *) b->data;         const char * d1 = d0 + ggml_nbytes(b);
+    return x0 == d0 || x1 <= d0 || d1 <= x0;
+}
