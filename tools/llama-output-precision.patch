+// Round quantized matrix outputs to the configured BF16 precision.
+// Accumulation remains FP32; round the completed output when
+// requested by the mining profile.
+static __global__ void meow_round_bf16(float * values, int64_t count) {
+    const int64_t i = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (i < count) values[i] = __bfloat162float(__float2bfloat16_rn(values[i]));
+}
+
 static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
     const bool split = ggml_backend_buft_is_cuda_split(src0->buffer->buft);
 
@@ -2262,6 +2270,16 @@
         ggml_cuda_op_mul_mat(ctx, src0, src1, dst, ggml_cuda_op_mul_mat_q, quantize_mmq_q8_1_cuda);
     } else {
         ggml_cuda_op_mul_mat(ctx, src0, src1, dst, ggml_cuda_op_mul_mat_cublas, nullptr);
+    }
+    static const bool bf16_outputs = [] {
+        const char * flag = getenv("MEOW_BF16_LINEAR_OUTPUTS");
+        return flag && flag[0] == '1';
+    }();
+    if (bf16_outputs && src0->type == GGML_TYPE_Q8_0 && dst->type == GGML_TYPE_F32) {
+        GGML_ASSERT(ggml_is_contiguous(dst));
+        const int64_t count = ggml_nelements(dst);
+        meow_round_bf16<<<(count+255)/256,256,0,ctx.stream()>>>((float *)dst->data,count);
+        CUDA_CHECK(cudaGetLastError());
     }
