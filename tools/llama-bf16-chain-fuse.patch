diff --git a/ggml/src/ggml-cuda/meow-fuse.cu b/ggml/src/ggml-cuda/meow-fuse.cu
new file mode 100644
index 0000000..b81c96c
--- /dev/null
+++ b/ggml/src/ggml-cuda/meow-fuse.cu
@@ -0,0 +1,76 @@
+// MEOW: producer/consumer fusion of the MEOW_BF16_GRAPH rounding chains.
+// Every bf16 rounding of the unfused graph is kept, in the same order, with the
+// same conversion and arithmetic helpers, so results are bit-identical.
+#include "meow-fuse.cuh"
+#include "unary.cuh"
+
+static __device__ __forceinline__ float meow_bf16(const float x) {
+    return __bfloat162float(__float2bfloat16(x));
+}
+
+// SwiGLU chain: out = r(r(silu(r(g))) * r(u)) — the ADDs/MULs of the graph are
+// SILU(ffn_gate), MUL(silu, ffn_up), with every intermediate rounded.
+static __device__ __forceinline__ float meow_swiglu_one(const float g, const float u) {
+    const float s = meow_bf16(ggml_cuda_op_silu_single(meow_bf16(g)));
+    return meow_bf16(s * meow_bf16(u));
+}
+
+// Residual chain: out = r(r(m) + r_other) where r_other is already rounded by
+// the graph (ffn_inp / previous l_out); the ADD operand order does not matter.
+static __device__ __forceinline__ float meow_add_one(const float m, const float o) {
+    return meow_bf16(meow_bf16(m) + o);
+}
+
+template <int kind>
+static __global__ void meow_chain_f32x4(const float4 * __restrict__ a, const float4 * __restrict__ b, float4 * __restrict__ dst, const int64_t n4) {
+    for (int64_t i = (int64_t)blockDim.x*blockIdx.x + threadIdx.x; i < n4; i += (int64_t)blockDim.x*gridDim.x) {
+        const float4 x = a[i];
+        const float4 y = b[i];
+        float4 r;
+        if constexpr (kind == 0) {
+            r.x = meow_swiglu_one(x.x, y.x); r.y = meow_swiglu_one(x.y, y.y);
+            r.z = meow_swiglu_one(x.z, y.z); r.w = meow_swiglu_one(x.w, y.w);
+        } else {
+            r.x = meow_add_one(x.x, y.x); r.y = meow_add_one(x.y, y.y);
+            r.z = meow_add_one(x.z, y.z); r.w = meow_add_one(x.w, y.w);
+        }
+        dst[i] = r;
+    }
+}
+
+template <int kind>
+static __global__ void meow_chain_f32(const float * __restrict__ a, const float * __restrict__ b, float * __restrict__ dst, const int64_t ne) {
+    for (int64_t i = (int64_t)blockDim.x*blockIdx.x + threadIdx.x; i < ne; i += (int64_t)blockDim.x*gridDim.x) {
+        dst[i] = kind == 0 ? meow_swiglu_one(a[i], b[i]) : meow_add_one(a[i], b[i]);
+    }
+}
+
+template <int kind>
+static void meow_chain(ggml_backend_cuda_context & ctx, const ggml_tensor * a, const ggml_tensor * b, ggml_tensor * dst) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && b->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(a) && ggml_is_contiguous(b) && ggml_is_contiguous(dst));
+    const int64_t ne = ggml_nelements(dst);
+    GGML_ASSERT(ggml_nelements(a) == ne && ggml_nelements(b) == ne);
+    if (ne == 0) {
+        return;
+    }
+    cudaStream_t stream = ctx.stream();
+    const int block = 256;
+    if (ne % 4 == 0 && (uintptr_t) a->data % 16 == 0 && (uintptr_t) b->data % 16 == 0 && (uintptr_t) dst->data % 16 == 0) {
+        const int64_t n4 = ne / 4;
+        const int blocks = (int) std::min<int64_t>((n4 + block - 1) / block, 65535);
+        meow_chain_f32x4<kind><<<blocks, block, 0, stream>>>((const float4 *) a->data, (const float4 *) b->data, (float4 *) dst->data, n4);
+    } else {
+        const int blocks = (int) std::min<int64_t>((ne + block - 1) / block, 65535);
+        meow_chain_f32<kind><<<blocks, block, 0, stream>>>((const float *) a->data, (const float *) b->data, (float *) dst->data, ne);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_meow_swiglu_bf16(ggml_backend_cuda_context & ctx, const ggml_tensor * gate, const ggml_tensor * up, ggml_tensor * dst) {
+    meow_chain<0>(ctx, gate, up, dst);
+}
+
+void ggml_cuda_meow_add_bf16(ggml_backend_cuda_context & ctx, const ggml_tensor * m, const ggml_tensor * other, ggml_tensor * dst) {
+    meow_chain<1>(ctx, m, other, dst);
+}
