# TensorCash vLLM miner config — defaults, all overridable by container env.
# Every value uses `: ${VAR:=default}` so `docker run -e VAR=...` wins.
# The code fixes (padded-vocab -inf slice, B_cred gate, revision pin, topk-opt,
# compact-CDF) are baked into the overlaid engine — not launcher flags.

# --- Model (chain-registered; do NOT change without a matching pool) ---------
: ${MINING_MODEL_NAME:=Qwen/Qwen3-8B}
# Revision pin (first-class): the proof's model_identifier is stamped @COMMIT.
# An unresolved commit -> @unknown -> verifier hangs. Keep pinned.
: ${MINING_MODEL_COMMIT:=9c925d64d72725edaf899c6cb9c377fd0709d9c5}
: ${MINING_DTYPE:=bfloat16}   # bf16 no-quant is consensus; proof commits to exact weights

# --- GPUs / parallelism -----------------------------------------------------
# GPUS: CUDA indices to combine ("all", "0", or "2,3" = a 2x16GB pair).
# PARALLEL: auto | pp | tp | single. auto: NVLink pair -> TP; PCIe pair -> PP.
: ${GPUS:=all}
: ${PARALLEL:=auto}
# High-batch defaults (audited at shipping volume, 120 proofs / 0 rejected).
# Knee at 256 (16GB pairs OOM past it; 32GB single KV-pressures past it).
# 0.84 util is the measured safe point; 512 ctx fits the ~300-token windows.
: ${GPU_MEM_UTIL:=0.84}
: ${MAX_MODEL_LEN:=512}
: ${MAX_NUM_SEQS:=256}

# --- PoW / proof egress -----------------------------------------------------
: ${POW_PROOF_VERSION:=3}
: ${POW_PROCESSOR_MODE:=python}   # python: no compiled ext needed (validated). cpp needs proof_processor.so (future optimization).
: ${POW_FAST_SETUP:=1}
: ${ZMQ_PUSH_PORT:=7911}       # engine connects; bridge PULL-binds

# --- Pool / bridge (POOL_HOST/PORT are parsed from $POOL by the entrypoint) --
: ${POOL_HOST:=tsc.suprnova.cc}
: ${POOL_PORT:=3310}
: ${WALLET:=YOUR_TSC_WALLET_ADDRESS}
: ${WORKER_SUFFIX:=vllmrig0}   # shows up as <wallet>.<suffix> on the pool
: ${B_FLOOR:=70}               # B_cred pre-submit gate (drop windows <70 bits)
: ${CONCURRENCY:=${MAX_NUM_SEQS}}   # match MAX_NUM_SEQS or the engine idles
: ${VLLM_API_KEY:=internal-secret}

# --- Runtime paths (container defaults) -------------------------------------
: ${VENV:=/opt/venv}
: ${PKG_DIR:=/app}
: ${HF_MODEL_CACHE:=/models}   # offline HF cache root (HF_HUB_CACHE)
