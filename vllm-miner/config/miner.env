# TensorCash vLLM multi-GPU miner — first-class config (round-5 GREEN build).
# Source this from run-miner.sh. Every value below is a knob the operator sets;
# the code fixes (padded-vocab -inf slice, B_cred gate, revision pin) are baked
# into the engine/bridge and are NOT ad-hoc launcher flags.

# --- Model (chain-registered; do NOT change without a matching pool) ---------
MINING_MODEL_NAME=Qwen/Qwen3-8B
# Revision pin (first-class): the proof's model_identifier is stamped @COMMIT.
# An unresolved commit -> @unknown -> verifier hangs (R1 bug). Keep pinned.
MINING_MODEL_COMMIT=9c925d64d72725edaf899c6cb9c377fd0709d9c5
MINING_DTYPE=bfloat16          # bf16 no-quant is consensus; the proof commits to exact weights

# --- GPUs / parallelism -----------------------------------------------------
# GPUS: nvidia-smi PCI_BUS_ID indices to combine (e.g. "2,3" = a 2x16GB pair).
# PARALLEL: auto | pp | tp | single. auto uses scripts/gpu_parallel_select.py:
#   NVLink pair -> tensor-parallel (TP); PCIe pair -> pipeline-parallel (PP).
GPUS=2,3
PARALLEL=auto
GPU_MEM_UTIL=0.90
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=32

# --- PoW / proof egress -----------------------------------------------------
POW_PROOF_VERSION=3
POW_PROCESSOR_MODE=cpp         # cpp proof processor (throughput); python for debug
POW_FAST_SETUP=1              # un-parked: skip redundant per-step promptmap .tolist() (~10ms/step)
ZMQ_PUSH_PORT=7911            # engine PUSHes proofs here; bridge PULLs (bind)

# --- Pool / bridge ----------------------------------------------------------
POOL_HOST=tsc.suprnova.cc    # or your pool's stratum host
POOL_PORT=3310
WALLET=YOUR_TSC_WALLET_ADDRESS
WORKER_SUFFIX=vllmrig0       # shows up as <wallet>.<suffix> on the pool
B_FLOOR=70                   # B_cred pre-submit gate (>=B_FREE); drop windows below (POW_V3_ADMISSION_MODE=off)
CONCURRENCY=8
VLLM_API_KEY=dbg

# --- Engine location --------------------------------------------------------
# TC_VLLM: the fork tree with the inf-fixed sampler (sha 50f2fdda). The wheel
# path (Ada/Ampere) overlays engine/topk_topp_sampler.py; Blackwell needs the
# source build. See docs/DEPLOYMENT.md.
TC_VLLM=$HOME/tc-vllm        # fork tree (or wheel venv) with the PoW sampler
VENV=$HOME/vllm-venv
HF_MODEL_CACHE=$HOME/hf-cache               # offline HF cache root (HF_HUB_CACHE)
