FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS build

ARG CUDA_ARCHS="80;86;89;90;120"
ARG JOBS=
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git patch ca-certificates \
        libssl-dev libzmq3-dev libargon2-dev libgmp-dev \
        flatbuffers-compiler libflatbuffers-dev python3 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v4.10.0 https://github.com/zeromq/cppzmq /tmp/cppzmq \
    && cp /tmp/cppzmq/zmq.hpp /tmp/cppzmq/zmq_addon.hpp /usr/include/ \
    && rm -rf /tmp/cppzmq

WORKDIR /src
COPY tools/             /src/tools/
COPY vendor/nlohmann/   /src/vendor/nlohmann/
COPY vendor/tensorcash/ /src/vendor/tensorcash/

ARG LLAMA_MAX_SEQ=512
ARG LLAMA_REPO=https://github.com/ocminer/llama.cpp
ARG LLAMA_COMMIT=966fb8619648da1b2033dd78ee12756cbc7ff3b0
COPY vendor/llama-src.tar.gz* vendor/nlohmann/json.hpp /tmp/
RUN rm -rf /src/vendor/llama.cpp && \
    if [ -f /tmp/llama-src.tar.gz ]; then \
      echo "using vendored llama fork" && \
      tar -xzf /tmp/llama-src.tar.gz -C /src/vendor/ && rm -f /tmp/llama-src.tar.gz; \
    else \
      echo "cloning ${LLAMA_REPO}" && \
      git clone --filter=blob:none "${LLAMA_REPO}" /src/vendor/llama.cpp && \
      cd /src/vendor/llama.cpp && git checkout -q "${LLAMA_COMMIT}" && \
      git apply --verbose /src/tools/llama-gpu-logits.patch; \
    fi && \
    bash /src/tools/prepare-llama.sh /src/vendor/llama.cpp

ENV LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib/stubs:${LIBRARY_PATH:-}

COPY CMakeLists.txt /src/
COPY src/           /src/src/

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHS}" \
      -DMEOW_LLAMA_DIR=/src/vendor/llama.cpp \
      -DMEOW_MAX_SEQUENCES="${LLAMA_MAX_SEQ}" \
      -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/targets/x86_64-linux/lib/stubs -lcuda" \
      -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/local/cuda/targets/x86_64-linux/lib/stubs -lcuda" \
 && cmake --build build -j"${JOBS:-$(nproc)}" --target supr-meow-tsc

RUN mkdir -p /deps \
 && for obj in /src/build/supr-meow-tsc /src/build/bin/*.so; do \
      ldd "$obj" 2>/dev/null | awk '/=> \//{print $3}'; \
    done | sort -u | while read -r lib; do \
      case "$(basename "$lib")" in \
        libcuda.so*|libnvidia-ml.so*|libc.so*|libm.so*|libdl.so*|librt.so*|\
        libpthread.so*|ld-linux*|libstdc++.so*|libgcc_s.so*) ;; \
        *) cp -L "$lib" /deps/ ;; \
      esac; \
    done \
 && ls /deps | tr '\n' ' '

FROM ubuntu:22.04 AS package
ARG PKG_VERSION=0.0.0
WORKDIR /out
COPY --from=build /src/build/supr-meow-tsc       /out/supr-meow-tsc/supr-meow-tsc
COPY --from=build /src/build/bin/*.so*           /out/supr-meow-tsc/lib/
COPY hiveos/                                     /out/supr-meow-tsc/
COPY mmpos/mmpos-run.sh                          /out/supr-meow-tsc/
COPY smos/smos-run.sh                            /out/supr-meow-tsc/
COPY tools/q8-profile.sh                         /out/supr-meow-tsc/
COPY tools/meow-common.sh                        /out/supr-meow-tsc/

COPY --from=build /usr/local/cuda/targets/x86_64-linux/lib/libcudart.so.12*    /out/supr-meow-tsc/lib/
COPY --from=build /usr/local/cuda/targets/x86_64-linux/lib/libcublas.so.12*    /out/supr-meow-tsc/lib/
COPY --from=build /usr/local/cuda/targets/x86_64-linux/lib/libcublasLt.so.12*  /out/supr-meow-tsc/lib/
COPY --from=build /deps/                                                      /out/supr-meow-tsc/lib/

RUN cd /out/supr-meow-tsc/lib \
 && md5sum *.so* | awk '{print $1, $2}' \
      | awk '{g[$1] = g[$1] " " $2} END {for (k in g) print g[k]}' \
      | while read -r group; do \
            canon=$(for f in $group; do echo "${#f} $f"; done | sort -rn | head -1 | cut -d' ' -f2-); \
            for f in $group; do \
              if [ "$f" != "$canon" ]; then ln -sf "$canon" "$f"; fi; \
            done; \
          done \
 && echo "lib/ is now $(du -sh . | cut -f1)"

RUN chmod +x /out/supr-meow-tsc/supr-meow-tsc /out/supr-meow-tsc/*.sh \
 && sed -i "s/^CUSTOM_VERSION=.*/CUSTOM_VERSION=${PKG_VERSION}/" /out/supr-meow-tsc/h-manifest.conf \
 && tar -czf /supr-meow-tsc-${PKG_VERSION}.tar.gz supr-meow-tsc \
 && ls -la /supr-meow-tsc-${PKG_VERSION}.tar.gz
